import { Button, ScrollView, LineEdit } from "std-widgets.slint";

export struct FileItem {
    name: string,
    is_dir: bool,
    size: string,
    date: string,
    icon: string,
}

// 1つのペイン（カラーバンド、タイポグラフィパス、ツールバー、ファイル一覧）
component FilePane inherits Rectangle {
    in-out property <string> path: "C:\\";
    in-out property <string> tail_name: "C:\\";
    in-out property <string> lead_path: "";
    in-out property <color> hue_color: #3b82f6;
    in-out property <[FileItem]> files: [];
    in-out property <int> selected_index: -1;
    in-out property <bool> is_active: true;
    in-out property <string> filter_text: "";
    in-out property <bool> can_go_back: false;
    in-out property <bool> can_go_forward: false;

    callback navigate_back();
    callback navigate_forward();
    callback navigate_up();
    callback refresh();
    callback new_folder();
    callback trash_selected();
    callback filter_changed(string);
    callback pane_activated();
    callback item_clicked(int);
    callback item_double_clicked(int);

    background: is_active ? #19191d : #141416;
    border-radius: 9px;
    border-width: 1.5px;
    border-color: is_active ? #3b82f6 : #27272a;
    clip: true;

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // ★思想1: 左端のカラーバンド（pathHue）
        Rectangle {
            width: 5px;
            background: root.hue_color;
        }

        // ペインメイン領域
        VerticalLayout {
            padding: 8px;
            spacing: 6px;

            // ★思想3: タイポグラフィの強弱（主役フォルダ名の大見出し太字化）
            Rectangle {
                height: 38px;
                background: is_active ? #202026 : #18181b;
                border-radius: 6px;
                border-width: 1px;
                border-color: is_active ? #383844 : #27272a;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;

                    // タイトル部（大見出し ＋ 親パス）
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: root.tail_name;
                            color: is_active ? #ffffff : #cbd5e1;
                            font-size: 14px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        if root.lead_path != "": Text {
                            text: root.lead_path;
                            color: #64748b;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }

                    // ツールバーボタン群
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;

                        // 戻る（Alt+Left）
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            background: !root.can_go_back ? #18181c : (back_touch.has_hover ? #3b82f6 : #27272e);
                            border-radius: 4px;
                            Text {
                                text: "←";
                                color: root.can_go_back ? #f8fafc : #475569;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            back_touch := TouchArea {
                                enabled: root.can_go_back;
                                clicked => { root.navigate_back(); }
                            }
                        }

                        // 進む（Alt+Right）
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            background: !root.can_go_forward ? #18181c : (fwd_touch.has_hover ? #3b82f6 : #27272e);
                            border-radius: 4px;
                            Text {
                                text: "→";
                                color: root.can_go_forward ? #f8fafc : #475569;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            fwd_touch := TouchArea {
                                enabled: root.can_go_forward;
                                clicked => { root.navigate_forward(); }
                            }
                        }

                        // 上へ戻る（Backspace）
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            background: up_touch.has_hover ? #3b82f6 : #27272e;
                            border-radius: 4px;
                            Text {
                                text: "↑";
                                color: #f8fafc;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            up_touch := TouchArea {
                                clicked => { root.navigate_up(); }
                            }
                        }

                        // 新規フォルダー（Ctrl+Shift+N）
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            background: new_touch.has_hover ? #3b82f6 : #27272e;
                            border-radius: 4px;
                            Text {
                                text: "＋";
                                color: #f8fafc;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            new_touch := TouchArea {
                                clicked => { root.new_folder(); }
                            }
                        }

                        // ゴミ箱へ送る（Delete）
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            background: del_touch.has_hover ? #ef4444 : #27272e;
                            border-radius: 4px;
                            Text {
                                text: "🗑";
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            del_touch := TouchArea {
                                clicked => { root.trash_selected(); }
                            }
                        }

                        // 再読み込み（F5）
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            background: ref_touch.has_hover ? #3b82f6 : #27272e;
                            border-radius: 4px;
                            Text {
                                text: "⟳";
                                color: #f8fafc;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ref_touch := TouchArea {
                                clicked => { root.refresh(); }
                            }
                        }
                    }
                }
            }

            // ★思想5: クイック絞り込みフィルターバー
            Rectangle {
                height: 28px;
                background: #141417;
                border-radius: 5px;
                border-width: 1px;
                border-color: #27272e;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    Text {
                        text: "🔍";
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    filter_input := LineEdit {
                        text <=> root.filter_text;
                        placeholder-text: "フォルダ内を絞り込み (Ctrl+F)…";
                        edited => { root.filter_changed(self.text); }
                    }
                }
            }

            // テーブルヘッダー
            Rectangle {
                height: 22px;
                background: #121214;
                border-radius: 4px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;

                    Text {
                        text: "名前";
                        color: #64748b;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "サイズ";
                        color: #64748b;
                        font-size: 11px;
                        font-weight: 600;
                        width: 75px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "更新日時";
                        color: #64748b;
                        font-size: 11px;
                        font-weight: 600;
                        width: 115px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }

            // ファイルリスト
            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 1px;
                    alignment: start;

                    for item[idx] in root.files: Rectangle {
                        height: 25px;
                        border-radius: 4px;
                        background: (root.selected_index == idx)
                            ? (root.is_active ? #2563eb : #1e3a8a)
                            : (row_touch.has_hover ? #25252c : transparent);

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;

                            Text {
                                text: item.icon;
                                font-size: 13px;
                                width: 18px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: item.name;
                                color: item.is_dir ? #93c5fd : (root.selected_index == idx ? #ffffff : #e2e8f0);
                                font-size: 12px;
                                font-weight: item.is_dir ? 600 : 400;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: item.size;
                                color: root.selected_index == idx ? #bfdbfe : #64748b;
                                font-size: 11px;
                                width: 75px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }

                            Text {
                                text: item.date;
                                color: root.selected_index == idx ? #bfdbfe : #64748b;
                                font-size: 11px;
                                width: 115px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        row_touch := TouchArea {
                            clicked => {
                                root.pane_activated();
                                root.selected_index = idx;
                                root.item_clicked(idx);
                            }
                            double-clicked => {
                                root.item_double_clicked(idx);
                            }
                        }
                    }
                }
            }

            // ペインフッター（ステータス）
            HorizontalLayout {
                height: 18px;
                padding-left: 4px;
                padding-right: 4px;

                Text {
                    text: root.files.length + " 項目" + (root.selected_index >= 0 ? " (1 選択)" : "");
                    color: #64748b;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Filer Native — ⚡ GPU-Direct Native Engine (Slint)";
    min-width: 960px;
    min-height: 600px;
    default-font-size: 12px;
    background: #0f0f11;

    in-out property <[string]> drives: ["C:\\"];
    in-out property <bool> split_mode: true;
    in-out property <int> active_pane: 0; // 0: 左ペイン, 1: 右ペイン

    // 履歴オーバーレイ状態
    in-out property <bool> show_history: false;
    in-out property <[string]> recent_history: [];

    // 左ペイン状態
    in-out property <string> left_path: "C:\\";
    in-out property <string> left_tail: "C:\\";
    in-out property <string> left_lead: "";
    in-out property <color> left_hue_color: #3b82f6;
    in-out property <[FileItem]> left_files: [];
    in-out property <int> left_selected: -1;
    in-out property <string> left_filter: "";
    in-out property <bool> left_can_back: false;
    in-out property <bool> left_can_forward: false;

    // 右ペイン状態
    in-out property <string> right_path: "C:\\";
    in-out property <string> right_tail: "C:\\";
    in-out property <string> right_lead: "";
    in-out property <color> right_hue_color: #3b82f6;
    in-out property <[FileItem]> right_files: [];
    in-out property <int> right_selected: -1;
    in-out property <string> right_filter: "";
    in-out property <bool> right_can_back: false;
    in-out property <bool> right_can_forward: false;

    in-out property <string> status_text: "⚡ GPUネイティブ描画エンジン稼働中";

    // コールバック
    callback drive_selected(string);
    callback toggle_split();
    callback switch_active_pane(int);
    callback toggle_history();
    callback select_history_item(string);
    callback clear_recent_history();

    // 左ペイン操作
    callback left_navigate_back();
    callback left_navigate_forward();
    callback left_navigate_up();
    callback left_refresh();
    callback left_new_folder();
    callback left_trash_selected();
    callback left_filter_changed(string);
    callback left_item_clicked(int);
    callback left_item_double_clicked(int);

    // 右ペイン操作
    callback right_navigate_back();
    callback right_navigate_forward();
    callback right_navigate_up();
    callback right_refresh();
    callback right_new_folder();
    callback right_trash_selected();
    callback right_filter_changed(string);
    callback right_item_clicked(int);
    callback right_item_double_clicked(int);

    // キーボード総合ハンドラ (text, ctrl, alt, shift)
    callback handle_key(string, bool, bool, bool) -> bool;

    forward-focus: key_handler;

    key_handler := FocusScope {
        key-pressed(event) => {
            if (root.handle_key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift)) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // グローバルトップバー
            HorizontalLayout {
                height: 36px;
                spacing: 8px;

                // ブランドロゴ
                Rectangle {
                    width: 140px;
                    background: #18181b;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #27272a;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "⚡ Filer Native";
                            color: #60a5fa;
                            font-size: 13px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }
                }

                // ドライブセレクター
                HorizontalLayout {
                    spacing: 4px;

                    for drive in root.drives: Rectangle {
                        width: 44px;
                        background: drv_touch.has_hover ? #3b82f6 : #1c1c20;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: #2e2e36;

                        Text {
                            text: drive;
                            color: #f1f5f9;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        drv_touch := TouchArea {
                            clicked => { root.drive_selected(drive); }
                        }
                    }
                }

                // ★履歴ドロップダウンボタン (Ctrl+H)
                Rectangle {
                    width: 115px;
                    background: root.show_history ? #2563eb : (hist_btn_touch.has_hover ? #2e2e38 : #1c1c20);
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: root.show_history ? #3b82f6 : #2e2e36;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "🕒 履歴";
                            color: root.show_history ? #ffffff : #e2e8f0;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.recent_history.length > 0 ? ("(" + root.recent_history.length + ")") : "";
                            color: root.show_history ? #bfdbfe : #94a3b8;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }

                    hist_btn_touch := TouchArea {
                        clicked => { root.toggle_history(); }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // 2画面分割トグルボタン
                Rectangle {
                    width: 115px;
                    background: split_touch.has_hover ? #2563eb : (root.split_mode ? #1e3a8a : #1c1c20);
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: root.split_mode ? #3b82f6 : #2e2e36;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        Text {
                            text: root.split_mode ? "⛶ 2画面分割中" : "🗖 単一画面";
                            color: root.split_mode ? #93c5fd : #94a3b8;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    split_touch := TouchArea {
                        clicked => { root.toggle_split(); }
                    }
                }
            }

            // メインワークスペース（ペインエリア ＋ 履歴オーバーレイ）
            Rectangle {
                vertical-stretch: 1;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 8px;

                    // 左ペイン
                    left_pane := FilePane {
                        horizontal-stretch: 1;
                        path: root.left_path;
                        tail_name: root.left_tail;
                        lead_path: root.left_lead;
                        hue_color: root.left_hue_color;
                        files: root.left_files;
                        selected_index: root.left_selected;
                        is_active: root.active_pane == 0;
                        filter_text <=> root.left_filter;
                        can_go_back: root.left_can_back;
                        can_go_forward: root.left_can_forward;

                        pane_activated => { root.switch_active_pane(0); }
                        navigate_back => { root.left_navigate_back(); }
                        navigate_forward => { root.left_navigate_forward(); }
                        navigate_up => { root.left_navigate_up(); }
                        refresh => { root.left_refresh(); }
                        new_folder => { root.left_new_folder(); }
                        trash_selected => { root.left_trash_selected(); }
                        filter_changed(t) => { root.left_filter_changed(t); }
                        item_clicked(idx) => { root.left_item_clicked(idx); }
                        item_double_clicked(idx) => { root.left_item_double_clicked(idx); }
                    }

                    // 右ペイン（2画面モード時のみ表示）
                    if root.split_mode: right_pane := FilePane {
                        horizontal-stretch: 1;
                        path: root.right_path;
                        tail_name: root.right_tail;
                        lead_path: root.right_lead;
                        hue_color: root.right_hue_color;
                        files: root.right_files;
                        selected_index: root.right_selected;
                        is_active: root.active_pane == 1;
                        filter_text <=> root.right_filter;
                        can_go_back: root.right_can_back;
                        can_go_forward: root.right_can_forward;

                        pane_activated => { root.switch_active_pane(1); }
                        navigate_back => { root.right_navigate_back(); }
                        navigate_forward => { root.right_navigate_forward(); }
                        navigate_up => { root.right_navigate_up(); }
                        refresh => { root.right_refresh(); }
                        new_folder => { root.right_new_folder(); }
                        trash_selected => { root.right_trash_selected(); }
                        filter_changed(t) => { root.right_filter_changed(t); }
                        item_clicked(idx) => { root.right_item_clicked(idx); }
                        item_double_clicked(idx) => { root.right_item_double_clicked(idx); }
                    }
                }

                // ★履歴ドロップダウン・ポップアップパネル（show_history が true の時に前面表示）
                if root.show_history: Rectangle {
                    x: 150px;
                    y: 4px;
                    width: 520px;
                    height: 320px;
                    background: #18181e;
                    border-radius: 8px;
                    border-width: 1.5px;
                    border-color: #3b82f6;
                    clip: true;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        // 履歴ヘッダー
                        HorizontalLayout {
                            height: 26px;
                            spacing: 8px;

                            Text {
                                text: "🕒 最近開いたフォルダー (Ctrl+H で閉じる)";
                                color: #f8fafc;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            // 履歴消去ボタン
                            Rectangle {
                                width: 55px;
                                height: 22px;
                                background: clr_touch.has_hover ? #ef4444 : #272732;
                                border-radius: 4px;
                                Text {
                                    text: "消去";
                                    color: #f8fafc;
                                    font-size: 10px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                clr_touch := TouchArea {
                                    clicked => { root.clear_recent_history(); }
                                }
                            }

                            // 閉じるボタン
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                background: close_touch.has_hover ? #3b82f6 : #272732;
                                border-radius: 4px;
                                Text {
                                    text: "✕";
                                    color: #cbd5e1;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                close_touch := TouchArea {
                                    clicked => { root.toggle_history(); }
                                }
                            }
                        }

                        // 履歴リスト
                        ScrollView {
                            vertical-stretch: 1;

                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;

                                for item_path in root.recent_history: Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: hist_item_touch.has_hover ? #2563eb : #202028;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;

                                        Text {
                                            text: "📁";
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: item_path;
                                            color: #f1f5f9;
                                            font-size: 11px;
                                            font-weight: 500;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    hist_item_touch := TouchArea {
                                        clicked => {
                                            root.select_history_item(item_path);
                                        }
                                    }
                                }

                                if root.recent_history.length == 0: Rectangle {
                                    height: 100px;
                                    Text {
                                        text: "まだ訪問履歴がありません";
                                        color: #64748b;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ★拡張ショートカットガイドフッター
            Rectangle {
                height: 26px;
                background: #121214;
                border-radius: 4px;
                border-width: 1px;
                border-color: #202026;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 12px;

                    Text {
                        text: root.status_text;
                        color: #34d399;
                        font-size: 11px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // キーボードショートカットの包括的ガイド
                    Text {
                        text: "Alt+←/→: 履歴戻る/進む · Ctrl+C/V: コピー/貼付 · Ctrl+Shift+N: 新規 · Ctrl+Shift+C: パスコピー · Ctrl+H: 履歴 · Del: ゴミ箱";
                        color: #64748b;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
